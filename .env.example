# Postgres connection string. Locally this defaults to
# postgres://postgres:postgres@localhost:5432/unprompted
# On Vercel, use your Supabase "Transaction pooler" URI.
DATABASE_URL=

# Show a password-free picker for accounts in your local development database.
DEV_ACCOUNT_PICKER=

# Moderator account created on deploy (password: at least 10 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address for badge links. Defaults to the Vercel production URL.
SITE_URL=

# GA4 web stream Measurement ID (G-...). Leave blank to disable. See README for stream settings.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Comma-separated login emails or numeric account IDs for team members to exclude from GA4.
# Admins and the company owner are excluded automatically.
GA4_EXCLUDED_ACCOUNTS=

# Public HTTPS URL of the Qikink Creator Store. Leave blank to hide the merch link.
MERCH_STORE_URL=

# ID of the company owner whose Marketplace merchandise sales appear in their dashboard.
# Leave empty to disable the private merch report.
COMPANY_OWNER_USER_ID=

# Qikink fulfillment for mapped company merchandise. Set on the server.
# Use the same environment as Cashfree (sandbox or production).
QIKINK_ENV=
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# JSON: listing slug -> customer-visible variant -> exact Qikink My Products SKU.
# Example: {"company-tee":{"Black / M":"YOUR-QIKINK-SKU"}}
QIKINK_CATALOG=

# Cashfree checkout for the company owner's paid listings (COMPANY_OWNER_USER_ID).
# Leave empty to keep using payment links. Keys: Cashfree dashboard → Developers → API Keys.
# CASHFREE_ENV is "sandbox" (test keys, default) or "production" (live keys).
# Webhook (live site): add <your site>/api/payments/cashfree/webhook in the dashboard.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Shown on the terms, privacy, refunds and contact pages.
LEGAL_NAME=
CONTACT_EMAIL=
LEGAL_ADDRESS=
GRIEVANCE_OFFICER=

# Password-reset emails, sent through Resend (https://resend.com).
# Without a key, emails are printed to the server log when running locally.
RESEND_API_KEY=
EMAIL_FROM="Unprompters <hello@unprompters.com>"

# "Continue with Google" on the log-in and sign-up pages. Leave empty to hide it.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application),
# with the redirect URI <your site>/api/auth/google/callback. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The seeded demo listings and Journal posts are hidden on the live site (Vercel
# production) and shown everywhere else. true or false here overrides that.
HIDE_DEMO_CONTENT=

# Where to email server errors (the first time each one happens in an hour, ten a
# day at most). Falls back to ADMIN_EMAIL. Needs RESEND_API_KEY.
ERROR_EMAIL=
