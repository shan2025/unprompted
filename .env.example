# Postgres connection string. Locally this defaults to
# postgres://postgres:postgres@localhost:5432/unprompted
# On Vercel, use your Supabase "Transaction pooler" URI.
DATABASE_URL=

# Moderator account created on deploy (password: at least 10 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address for badge links. Defaults to the Vercel production URL.
SITE_URL=

# Shown on the terms, privacy, refunds and contact pages.
LEGAL_NAME=
CONTACT_EMAIL=
LEGAL_ADDRESS=
GRIEVANCE_OFFICER=

# Password-reset emails, sent through Resend (https://resend.com).
# Without a key, emails are printed to the server log when running locally.
RESEND_API_KEY=
EMAIL_FROM="Unprompters <hello@unprompters.com>"

# "Continue with Google" on the log-in and sign-up pages. Leave empty to hide it.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application),
# with the redirect URI <your site>/api/auth/google/callback. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true to hide the seeded demo listings and Journal posts from the public site.
HIDE_DEMO_CONTENT=
